# Cross-compiles for Windows x64 from macOS or Linux with zig (brew install zig)
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
get_filename_component(_dir "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
set(CMAKE_C_COMPILER "${_dir}/zig-win64-cc.sh")
set(CMAKE_CXX_COMPILER "${_dir}/zig-win64-cxx.sh")
set(CMAKE_AR "${_dir}/zig-ar.sh")
set(CMAKE_RANLIB "${_dir}/zig-ranlib.sh")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
